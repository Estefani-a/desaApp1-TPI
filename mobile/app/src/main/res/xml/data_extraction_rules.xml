<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Exclude Tink keyset and encrypted JWT DataStore because Android Keystore keys are not transferable. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="uniride_token_keyset_prefs.xml" />
        <exclude domain="file" path="datastore/uniride_session_token.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="uniride_token_keyset_prefs.xml" />
        <exclude domain="file" path="datastore/uniride_session_token.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
