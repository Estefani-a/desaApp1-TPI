# Variables del backend y de docker-compose.yml (CONVENCIONES §10.6).
# Copiá este archivo a .env y completalo. El .env NUNCA se commitea.

# Base de datos. docker compose crea la base "uniride" con este usuario y contraseña.
DB_USER=uniride
DB_PASSWORD=cambiar-esta-contrasena
# Solo para correr el backend fuera de Docker (perfil "local"). En Docker lo fija docker-compose.yml.
DB_URL=jdbc:postgresql://localhost:5432/uniride

# Firma de los JWT (HS256): al menos 32 caracteres. Generá uno propio, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# SMTP. En desarrollo es Mailpit (los correos se ven en http://localhost:8025).
# Solo para el perfil "local"; en Docker lo fija docker-compose.yml.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@uniride.uade.edu.ar

# Base de los enlaces de los correos (docs/API.md §8). Con el emulador: http://10.0.2.2:8080
APP_LINK_BASE_URL=http://10.0.2.2:8080

# Ruta a la cuenta de servicio de Firebase (push). Vacío: el backend arranca igual y
# registra en el log las push que hubiera enviado.
FIREBASE_CREDENTIALS_PATH=

# Perfiles de Spring del backend en Docker. Sin esta variable, docker-compose.yml usa "demo",
# que carga los usuarios de prueba con contraseña conocida (backend/README.md). Para levantarlo
# sin esas cuentas, descomentala vacía:
# SPRING_PROFILES_ACTIVE=
